From c8672a3f9274b61b985c6c0065f732c39cb74de7 Mon Sep 17 00:00:00 2001
From: VioletCore Builder <violetcore@example.local>
Date: Sun, 26 Jul 2026 08:44:00 +0000
Subject: [PATCH] VioletCore engine plugin server hooks

---
 net/minecraft/server/MinecraftServer.java   | 6 ++++++
 net/minecraft/server/level/ServerLevel.java | 5 +++++
 2 files changed, 11 insertions(+)

diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index ece422e..3d4d877 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1025,6 +1025,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         }
 
         LOGGER.info("Stopping server");
+        io.violetmc.violetcore.engine.EnginePluginManager.fireServerStopping(); // VioletCore - Engine Plugin lifecycle
         Commands.COMMAND_SENDING_POOL.shutdownNow(); // Paper - Perf: Async command map building; Shutdown and don't bother finishing
         // Purpur start - UPnP Port Forwarding
         if (upnp) {
@@ -1109,6 +1110,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         // Paper end - rewrite chunk system
         // Paper start - Improved watchdog support - move final shutdown items here
         Util.shutdownExecutors();
+        io.violetmc.violetcore.engine.EnginePluginManager.shutdown(); // VioletCore - close Engine Plugin classloaders on full shutdown
         this.onServerExit();
         // Paper end - Improved watchdog support - move final shutdown items here
     }
@@ -1300,6 +1302,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             // tasks are default scheduled at -1 + delay, and first tick will tick at 1
             final long actualDoneTimeMs = System.currentTimeMillis() - org.bukkit.craftbukkit.Main.BOOT_TIME.toEpochMilli(); // Paper - Improve startup message
             LOGGER.info("Done ({})! For help, type \"help\"", String.format(java.util.Locale.ROOT, "%.3fs", actualDoneTimeMs / 1000.00D)); // Paper - Improve startup message
+            io.violetmc.violetcore.engine.EnginePluginManager.fireServerStarted(); // VioletCore - Engine Plugin lifecycle
             org.spigotmc.WatchdogThread.tick();
             // Paper end
             org.spigotmc.WatchdogThread.hasStarted = true; // Paper
@@ -1407,6 +1410,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             LOGGER.error("Encountered an unexpected exception", t);
             CrashReport report = constructOrExtractCrashReport(t);
             this.fillSystemReport(report.getSystemReport());
+            io.violetmc.violetcore.engine.EnginePluginManager.addCrashReportDetails(report.getSystemReport()); // VioletCore - include Engine Plugins in crash reports
             Path file = this.getServerDirectory().resolve("crash-reports").resolve("crash-" + Util.getFilenameFormattedDateTime() + "-server.txt");
             if (report.saveToFile(file, ReportType.CRASH)) {
                 LOGGER.error("This crash report has been saved to: {}", file.toAbsolutePath());
@@ -1653,6 +1657,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         this.server.spark.tickStart(); // Paper - spark
         new com.destroystokyo.paper.event.server.ServerTickStartEvent(this.tickCount+1).callEvent(); // Paper - Server Tick Events
         this.tickCount++;
+        io.violetmc.violetcore.engine.EnginePluginManager.fireServerTickStart(this.tickCount); // VioletCore - Engine Plugin tick hook
         this.tickRateManager.tick();
         this.tickChildren(haveTime);
         if (nano - this.lastServerStatus >= STATUS_EXPIRE_TIME_NANOS) {
@@ -1692,6 +1697,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         // Paper start - Server Tick Events
         long endTime = System.nanoTime();
         long remaining = this.nextTickTimeNanos - endTime;
+        io.violetmc.violetcore.engine.EnginePluginManager.fireServerTickEnd(this.tickCount, ((double)(endTime - this.currentTickStart) / 1000000D), remaining); // VioletCore - Engine Plugin tick hook
         new com.destroystokyo.paper.event.server.ServerTickEndEvent(this.tickCount, ((double)(endTime - this.currentTickStart) / 1000000D), remaining).callEvent();
         // Paper end - Server Tick Events
         this.server.spark.tickEnd(((double)(endTime - this.currentTickStart) / 1000000D)); // Paper - spark
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 31f0e6d..8ff3bfc 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -918,6 +918,11 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
                                         entity.stopRiding();
                                     }
 
+                                    // VioletCore start - Engine Plugin entity tick controller
+                                    if (!io.violetmc.violetcore.engine.EnginePluginManager.shouldTickEntity(entity.getBukkitEntity(), this.getWorld().getName(), this.server.getTickCount())) {
+                                        return;
+                                    }
+                                    // VioletCore end - Engine Plugin entity tick controller
                                     profiler.push("tick");
                                     this.guardEntityTick(this::tickNonPassenger, entity);
                                     profiler.pop();
-- 
