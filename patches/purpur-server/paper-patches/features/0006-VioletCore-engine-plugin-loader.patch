+package io.violetmc.violetcore.engine;
+import io.violetmc.violetcore.engine.api.*; import java.io.*; import java.net.URLClassLoader;
+final class EnginePluginInstance implements Closeable { private final EnginePluginDescription description; private final URLClassLoader classLoader; private final EnginePlugin plugin; private final EnginePluginContext context; EnginePluginInstance(EnginePluginDescription description, URLClassLoader classLoader, EnginePlugin plugin, EnginePluginContext context){this.description=description;this.classLoader=classLoader;this.plugin=plugin;this.context=context;} EnginePluginDescription description(){return description;} EnginePlugin plugin(){return plugin;} EnginePluginContext context(){return context;} public void close() throws IOException{classLoader.close();} }
diff --git a/src/main/java/io/violetmc/violetcore/engine/EnginePluginManager.java b/src/main/java/io/violetmc/violetcore/engine/EnginePluginManager.java
new file mode 100644
index 000000000..9ce7eb089
--- /dev/null
+++ b/src/main/java/io/violetmc/violetcore/engine/EnginePluginManager.java
@@ -0,0 +1,15 @@
+package io.violetmc.violetcore.engine;
+import io.violetmc.violetcore.engine.api.*; import java.io.*; import java.lang.reflect.*; import java.net.*; import java.nio.file.*; import java.util.*; import java.util.concurrent.*; import java.util.jar.*; import java.util.logging.*; import java.util.regex.*; import net.minecraft.SystemReport;
+public final class EnginePluginManager { public static final String SERVER_NAME="VioletCore", TARGET_VERSION="26.2", METADATA_FILE="engine-plugin.yml", ENTITY_TICKING_AREA="entity-ticking"; private static final Pattern SAFE_PLUGIN_NAME=Pattern.compile("[A-Za-z0-9_.-]{1,64}"); private static final Logger LOGGER=Logger.getLogger("VioletCore/EnginePlugins"); private static final List<EnginePluginInstance> LOADED_PLUGINS=new CopyOnWriteArrayList<>(); private static final List<RegisteredTickObserver> TICK_OBSERVERS=new CopyOnWriteArrayList<>(); private static final List<RegisteredEntityTickController> ENTITY_TICK_CONTROLLERS=new CopyOnWriteArrayList<>(); private static final Set<String> CLAIMED_MODIFICATION_AREAS=new HashSet<>(); private static volatile boolean bootstrapped, disabled, serverStarted, serverStopping; private static volatile Path enginePluginsDirectory=Path.of("engine-plugins"); private static volatile EnginePluginConfig config=EnginePluginConfig.defaults(); private EnginePluginManager(){}
+ public static synchronized void bootstrap(Path directory, boolean disableEnginePlugins){ if(bootstrapped){LOGGER.warning("EnginePluginManager.bootstrap was called more than once; ignoring the second call.");return;} bootstrapped=true; disabled=disableEnginePlugins; enginePluginsDirectory=directory==null?Path.of("engine-plugins"):directory; config=EnginePluginConfig.load(Path.of(EnginePluginConfig.CONFIG_FILE_NAME)); LOGGER.info("Starting "+SERVER_NAME+" Engine Plugin bootstrap for target version "+TARGET_VERSION+"."); if(config.debugLogging()) LOGGER.info("Engine config: "+String.join("; ",config.summaryLines())); if(disabled||!config.engineEnabled()){disabled=true;LOGGER.warning("Engine Plugins are disabled by command-line flag, system property, or engine-plugins.yml.");return;} try{Files.createDirectories(enginePluginsDirectory);}catch(IOException ex){LOGGER.log(Level.SEVERE,"Could not create engine plugin directory "+enginePluginsDirectory.toAbsolutePath(),ex);return;} final List<Path> jars; try(var stream=Files.list(enginePluginsDirectory)){jars=stream.filter(p->Files.isRegularFile(p)&&p.getFileName().toString().toLowerCase(Locale.ROOT).endsWith(".jar")).sorted(Comparator.comparing(p->p.getFileName().toString().toLowerCase(Locale.ROOT))).toList();}catch(IOException ex){LOGGER.log(Level.SEVERE,"Could not list engine plugin directory "+enginePluginsDirectory.toAbsolutePath(),ex);return;} if(jars.isEmpty()){LOGGER.info("No Engine Plugins found in "+enginePluginsDirectory.toAbsolutePath()+".");return;} Map<String,EnginePluginDescription> accepted=new LinkedHashMap<>(); Map<String,Set<String>> claimed=new HashMap<>(); for(Path jar:jars){EnginePluginDescription d; try{d=readDescription(jar);}catch(Exception ex){LOGGER.log(Level.SEVERE,"Skipping invalid Engine Plugin jar "+jar.toAbsolutePath(),ex);continue;} if(config.isPluginDisabled(d.name())){LOGGER.warning("Skipping Engine Plugin "+d.displayName()+": disabled in "+config.path().toAbsolutePath()+".");continue;} if(!validateDescription(d)||!validateConflicts(d,accepted,claimed))continue; accepted.put(d.name(),d); claimed.put(d.name(),new HashSet<>(d.modifies())); CLAIMED_MODIFICATION_AREAS.addAll(d.modifies());} accepted.values().forEach(EnginePluginManager::load); LOGGER.info("Engine Plugin bootstrap complete. Loaded "+LOADED_PLUGINS.size()+" plugin(s): "+describeLoadedPlugins()+"."); if(!TICK_OBSERVERS.isEmpty())LOGGER.info("Registered "+TICK_OBSERVERS.size()+" Engine Plugin tick observer(s)."); if(!ENTITY_TICK_CONTROLLERS.isEmpty())LOGGER.info("Registered "+ENTITY_TICK_CONTROLLERS.size()+" Engine Plugin entity tick controller(s)."); }
+ private static EnginePluginDescription readDescription(Path jarPath)throws IOException{try(JarFile jar=new JarFile(jarPath.toFile())){JarEntry e=jar.getJarEntry(METADATA_FILE); if(e==null)e=jar.getJarEntry("violet-engine-plugin.yml"); if(e==null)e=jar.getJarEntry("META-INF/"+METADATA_FILE); if(e==null)throw new IOException("Missing "+METADATA_FILE+" metadata"); try(InputStream in=jar.getInputStream(e)){return EnginePluginDescriptionParser.parse(in,jarPath);}}}
+ private static boolean validateDescription(EnginePluginDescription d){ if(!SAFE_PLUGIN_NAME.matcher(d.name()).matches()){LOGGER.severe("Skipping Engine Plugin "+d.displayName()+": unsafe name.");return false;} if(!"engine-plugin".equalsIgnoreCase(d.type())){LOGGER.severe("Skipping Engine Plugin "+d.displayName()+": type must be engine-plugin but was "+d.type()+".");return false;} if(d.mainClass()==null){LOGGER.severe("Skipping Engine Plugin "+d.displayName()+": missing required main class.");return false;} if(!"pre-minecraft".equalsIgnoreCase(d.loadPhase())){LOGGER.severe("Skipping Engine Plugin "+d.displayName()+": only load-phase pre-minecraft is supported.");return false;} if(!SERVER_NAME.equalsIgnoreCase(d.targetServer())){LOGGER.severe("Skipping Engine Plugin "+d.displayName()+": target-server must be "+SERVER_NAME+" but was "+d.targetServer()+".");return false;} if(!TARGET_VERSION.equals(d.targetVersion())){String m="Engine Plugin "+d.displayName()+": target-version should be "+TARGET_VERSION+" but was "+d.targetVersion()+"."; if(config.strictVersionCheck()){LOGGER.severe("Skipping "+m);return false;} LOGGER.warning(m+" strict-version-check=false, loading anyway.");} if(d.reloadable())LOGGER.warning("Engine Plugin "+d.displayName()+" declares reloadable=true; restart-only enforced."); if(!d.mixinConfigs().isEmpty())LOGGER.warning("Engine Plugin "+d.displayName()+" declares mixin configs "+d.mixinConfigs()+". Mixins are not enabled yet."); return true; }
+ private static boolean validateConflicts(EnginePluginDescription d, Map<String,EnginePluginDescription> accepted, Map<String,Set<String>> claimed){ if(accepted.containsKey(d.name())){LOGGER.severe("Skipping duplicate Engine Plugin name: "+d.name());return false;} for(String c:d.conflicts())if(accepted.containsKey(c)){LOGGER.severe("Skipping Engine Plugin "+d.displayName()+": conflicts with "+c+".");return false;} for(EnginePluginDescription a:accepted.values())if(a.conflicts().contains(d.name())){LOGGER.severe("Skipping Engine Plugin "+d.displayName()+": conflict declared by "+a.displayName()+".");return false;} for(String area:d.modifies())for(var e:claimed.entrySet())if(e.getValue().contains(area)){LOGGER.severe("Skipping Engine Plugin "+d.displayName()+": modification area '"+area+"' is already claimed by "+e.getKey()+".");return false;} return true; }
+ private static void load(EnginePluginDescription d){ Path data=enginePluginsDirectory.resolve(d.name()).normalize(); if(!data.startsWith(enginePluginsDirectory.normalize())){LOGGER.severe("Skipping Engine Plugin "+d.displayName()+": data directory escapes engine plugin directory.");return;} try{Files.createDirectories(data);}catch(IOException ex){LOGGER.log(Level.SEVERE,"Could not create data directory for Engine Plugin "+d.displayName(),ex);return;} try{URLClassLoader cl=new URLClassLoader(new URL[]{d.source().toUri().toURL()},EnginePluginManager.class.getClassLoader()); Class<?> main=Class.forName(d.mainClass(),true,cl); Object obj=instantiate(main); if(!(obj instanceof EnginePlugin plugin)){cl.close();LOGGER.severe("Skipping Engine Plugin "+d.displayName()+": main class does not implement "+EnginePlugin.class.getName()+".");return;} SimpleEnginePluginContext ctx=new SimpleEnginePluginContext(d,data,enginePluginsDirectory); plugin.onLoad(ctx); LOADED_PLUGINS.add(new EnginePluginInstance(d,cl,plugin,ctx)); LOGGER.info("Loaded Engine Plugin "+d.displayName()+" from "+d.source().getFileName()+".");}catch(Throwable t){LOGGER.log(Level.SEVERE,"Failed to load Engine Plugin "+d.displayName()+". It will not be enabled.",t); if(config.failFastOnPluginError())throw new IllegalStateException("Engine Plugin "+d.displayName()+" failed and fail-fast-on-plugin-error=true",t);} }
+ private static Object instantiate(Class<?> main)throws ReflectiveOperationException{Constructor<?> c=main.getDeclaredConstructor(); c.setAccessible(true); return c.newInstance();} static void registerTickObserver(EnginePluginDescription d, TickObserver o){TICK_OBSERVERS.add(new RegisteredTickObserver(d,o));LOGGER.info("Engine Plugin "+d.displayName()+" registered a tick observer.");} static void registerEntityTickController(EnginePluginDescription d, EntityTickController c){if(config.warnUndeclaredEntityController()&&!d.modifies().contains(ENTITY_TICKING_AREA))LOGGER.warning("Engine Plugin "+d.displayName()+" registered an entity tick controller without declaring modifies: "+ENTITY_TICKING_AREA+"."); ENTITY_TICK_CONTROLLERS.add(new RegisteredEntityTickController(d,c));LOGGER.info("Engine Plugin "+d.displayName()+" registered an entity tick controller.");}
