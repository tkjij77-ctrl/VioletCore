diff --git a/src/main/java/io/violetmc/violetcore/engine/EnginePluginConfig.java b/src/main/java/io/violetmc/violetcore/engine/EnginePluginConfig.java
new file mode 100644
index 000000000..49441247d
--- /dev/null
+++ b/src/main/java/io/violetmc/violetcore/engine/EnginePluginConfig.java
@@ -0,0 +1,30 @@
+package io.violetmc.violetcore.engine;
+
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.util.*;
+import java.util.logging.*;
+
+final class EnginePluginConfig {
+    static final String CONFIG_FILE_NAME = "engine-plugins.yml";
+    private static final Logger LOGGER = Logger.getLogger("VioletCore/EnginePlugins");
+    private final Path path;
+    private final boolean engineEnabled, strictVersionCheck, warnUndeclaredEntityController, failFastOnPluginError, debugLogging;
+    private final Set<String> disabledPlugins;
+    private EnginePluginConfig(Path path, boolean engineEnabled, boolean strictVersionCheck, boolean warnUndeclaredEntityController, boolean failFastOnPluginError, boolean debugLogging, Set<String> disabledPlugins) { this.path=path; this.engineEnabled=engineEnabled; this.strictVersionCheck=strictVersionCheck; this.warnUndeclaredEntityController=warnUndeclaredEntityController; this.failFastOnPluginError=failFastOnPluginError; this.debugLogging=debugLogging; this.disabledPlugins=Set.copyOf(disabledPlugins); }
+    static EnginePluginConfig defaults() { return new EnginePluginConfig(Path.of(CONFIG_FILE_NAME), true, true, true, false, false, Set.of()); }
+    static EnginePluginConfig load(Path path) {
+        Path configPath = path == null ? Path.of(CONFIG_FILE_NAME) : path;
+        try { if (Files.notExists(configPath)) writeDefault(configPath); } catch (IOException ex) { LOGGER.log(Level.WARNING, "Could not write default engine-plugins.yml", ex); return defaults(); }
+        boolean engineEnabled=true, strictVersionCheck=true, warnUndeclaredEntityController=true, failFastOnPluginError=false, debugLogging=false; Set<String> disabledPlugins=new LinkedHashSet<>(); String activeList=null;
+        try (BufferedReader reader=Files.newBufferedReader(configPath, StandardCharsets.UTF_8)) { String raw; while ((raw=reader.readLine())!=null) { String line=stripComment(raw).stripTrailing(); if (line.isBlank()) continue; String stripped=line.stripLeading(); if (stripped.startsWith("- ")) { if ("disabled-plugins".equals(activeList)) { String v=unquote(stripped.substring(2).trim()); if (!v.isBlank()) disabledPlugins.add(v);} continue;} int sep=line.indexOf(':'); if (sep<0) continue; String key=line.substring(0,sep).trim().toLowerCase(Locale.ROOT).replace('_','-'); String value=line.substring(sep+1).trim(); activeList=key; switch(key){ case "engine-enabled" -> engineEnabled=parseBoolean(value,engineEnabled); case "strict-version-check" -> strictVersionCheck=parseBoolean(value,strictVersionCheck); case "warn-undeclared-entity-controller" -> warnUndeclaredEntityController=parseBoolean(value,warnUndeclaredEntityController); case "fail-fast-on-plugin-error" -> failFastOnPluginError=parseBoolean(value,failFastOnPluginError); case "debug-logging" -> debugLogging=parseBoolean(value,debugLogging); case "disabled-plugins" -> { if (value.startsWith("[") && value.endsWith("]")) { for (String item:value.substring(1,value.length()-1).split(",")) { String v=unquote(item.trim()); if(!v.isBlank()) disabledPlugins.add(v);} } else if(!value.isBlank()) disabledPlugins.add(unquote(value)); } default -> {} } } } catch(IOException ex){ LOGGER.log(Level.WARNING,"Could not read "+configPath.toAbsolutePath(),ex); return defaults(); }
+        return new EnginePluginConfig(configPath, engineEnabled, strictVersionCheck, warnUndeclaredEntityController, failFastOnPluginError, debugLogging, disabledPlugins);
+    }
+    private static void writeDefault(Path path) throws IOException { Path parent=path.toAbsolutePath().getParent(); if(parent!=null) Files.createDirectories(parent); Files.writeString(path, "# VioletCore Engine Plugin configuration\nengine-enabled: true\nstrict-version-check: true\nwarn-undeclared-entity-controller: true\nfail-fast-on-plugin-error: false\ndebug-logging: false\ndisabled-plugins: []\n", StandardCharsets.UTF_8); }
+    private static boolean parseBoolean(String value, boolean fallback){ if(value==null||value.isBlank()) return fallback; return switch(unquote(value).trim().toLowerCase(Locale.ROOT)){ case "true","yes","1","on" -> true; case "false","no","0","off" -> false; default -> fallback; }; }
+    private static String stripComment(String line){ boolean s=false,d=false; for(int i=0;i<line.length();i++){ char c=line.charAt(i); if(c=='\''&&!d)s=!s; else if(c=='"'&&!s)d=!d; else if(c=='#'&&!s&&!d)return line.substring(0,i);} return line; }
+    private static String unquote(String value){ if(value.length()>=2 && ((value.startsWith("\"")&&value.endsWith("\"")) || (value.startsWith("'")&&value.endsWith("'")))) return value.substring(1,value.length()-1); return value; }
+    Path path(){return path;} boolean engineEnabled(){return engineEnabled;} boolean strictVersionCheck(){return strictVersionCheck;} boolean warnUndeclaredEntityController(){return warnUndeclaredEntityController;} boolean failFastOnPluginError(){return failFastOnPluginError;} boolean debugLogging(){return debugLogging;} Set<String> disabledPlugins(){return disabledPlugins;} boolean isPluginDisabled(String name){return disabledPlugins.stream().anyMatch(d->d.equalsIgnoreCase(name));}
+    List<String> summaryLines(){ return List.of("path=" + path.toAbsolutePath(), "engine-enabled="+engineEnabled, "strict-version-check="+strictVersionCheck, "warn-undeclared-entity-controller="+warnUndeclaredEntityController, "fail-fast-on-plugin-error="+failFastOnPluginError, "debug-logging="+debugLogging, "disabled-plugins="+(disabledPlugins.isEmpty()?"[]":disabledPlugins.toString())); }
+}
diff --git a/src/main/java/io/violetmc/violetcore/engine/EnginePluginDescriptionParser.java b/src/main/java/io/violetmc/violetcore/engine/EnginePluginDescriptionParser.java
new file mode 100644
index 000000000..9068ecc3f
--- /dev/null
+++ b/src/main/java/io/violetmc/violetcore/engine/EnginePluginDescriptionParser.java
@@ -0,0 +1,133 @@
+package io.violetmc.violetcore.engine;
+
+import io.violetmc.violetcore.engine.api.EnginePluginDescription;
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+final class EnginePluginDescriptionParser {
+    private EnginePluginDescriptionParser() {
+    }
+
+    static EnginePluginDescription parse(final InputStream inputStream, final Path source) throws IOException {
+        final Map<String, List<String>> values = new LinkedHashMap<>();
+        String currentListKey = null;
+
+        try (BufferedReader reader = new BufferedReader(new InputStreamReader(inputStream, StandardCharsets.UTF_8))) {
+            String rawLine;
+            while ((rawLine = reader.readLine()) != null) {
+                String line = stripComment(rawLine).stripTrailing();
+                if (line.isBlank()) {
+                    continue;
+                }
+
+                final String stripped = line.stripLeading();
+                if (stripped.startsWith("- ")) {
+                    if (currentListKey == null) {
+                        throw new IOException("List item found before a key in " + source + ": " + rawLine);
+                    }
+                    values.computeIfAbsent(currentListKey, ignored -> new ArrayList<>()).add(unquote(stripped.substring(2).trim()));
+                    continue;
+                }
+
+                final int separator = line.indexOf(':');
+                if (separator < 0) {
+                    throw new IOException("Invalid engine plugin metadata line in " + source + ": " + rawLine);
+                }
+
+                final String key = normalizeKey(line.substring(0, separator));
+                final String value = line.substring(separator + 1).trim();
+                currentListKey = key;
+                if (value.isEmpty()) {
+                    values.computeIfAbsent(key, ignored -> new ArrayList<>());
+                } else if (value.startsWith("[") && value.endsWith("]")) {
+                    values.put(key, parseInlineList(value));
+                } else {
+                    final ArrayList<String> list = new ArrayList<>();
+                    list.add(unquote(value));
+                    values.put(key, list);
+                }
+            }
+        }
+
+        return new EnginePluginDescription(
+            first(values, "name"),
+            first(values, "version"),
+            first(values, "main"),
+            first(values, "type"),
+            first(values, "target-server"),
+            first(values, "target-version"),
+            first(values, "load-phase"),
+            Boolean.parseBoolean(firstOrDefault(values, "reloadable", "false")),
+            list(values, "modifies"),
+            list(values, "conflicts"),
+            list(values, "mixin-configs"),
+            source
+        );
+    }
+
+    private static String normalizeKey(final String key) {
+        return key.trim().toLowerCase(Locale.ROOT).replace('_', '-');
+    }
+
+    private static String first(final Map<String, List<String>> values, final String key) {
+        final List<String> list = values.get(key);
+        return list == null || list.isEmpty() ? null : list.get(0);
+    }
+
+    private static String firstOrDefault(final Map<String, List<String>> values, final String key, final String defaultValue) {
+        final String value = first(values, key);
+        return value == null ? defaultValue : value;
+    }
+
+    private static List<String> list(final Map<String, List<String>> values, final String key) {
+        final List<String> list = values.get(key);
+        return list == null ? List.of() : list;
+    }
+
+    private static List<String> parseInlineList(final String value) {
+        final String body = value.substring(1, value.length() - 1).trim();
+        if (body.isEmpty()) {
+            return List.of();
+        }
+        final List<String> output = new ArrayList<>();
+        for (final String item : body.split(",")) {
+            final String cleaned = unquote(item.trim());
+            if (!cleaned.isEmpty()) {
+                output.add(cleaned);
+            }
+        }
+        return output;
+    }
+
+    private static String stripComment(final String line) {
+        boolean inSingle = false;
+        boolean inDouble = false;
+        for (int i = 0; i < line.length(); i++) {
+            final char c = line.charAt(i);
+            if (c == '\'' && !inDouble) {
+                inSingle = !inSingle;
+            } else if (c == '"' && !inSingle) {
+                inDouble = !inDouble;
+            } else if (c == '#' && !inSingle && !inDouble) {
+                return line.substring(0, i);
+            }
+        }
+        return line;
+    }
+
+    private static String unquote(final String value) {
+        if (value.length() >= 2 && ((value.startsWith("\"") && value.endsWith("\"")) || (value.startsWith("'") && value.endsWith("'")))) {
+            return value.substring(1, value.length() - 1);
+        }
+        return value;
+    }
+}
