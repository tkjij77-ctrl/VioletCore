diff --git a/src/main/java/io/violetmc/violetcore/engine/api/EnginePlugin.java b/src/main/java/io/violetmc/violetcore/engine/api/EnginePlugin.java
index eb0348378bb6043acf7b622f20001a512fdc9de4..73b94e501810030a182db8a2370a7d70962047cc 100644
--- a/src/main/java/io/violetmc/violetcore/engine/api/EnginePlugin.java
+++ b/src/main/java/io/violetmc/violetcore/engine/api/EnginePlugin.java
@@ -1,20 +1,8 @@
 package io.violetmc.violetcore.engine.api;
 
-/**
- * Entry point for VioletCore Engine Plugins.
- *
- * <p>Engine Plugins are loaded before normal Bukkit/Paper plugins and may
- * register low-level hooks exposed by VioletCore. They are version-locked and
- * require a full server restart when changed.</p>
- */
 public interface EnginePlugin {
-    /**
-     * Called during VioletCore bootstrap, before the Paper/Purpur server layer
-     * is fully started.
-     *
-     * @param context engine plugin context
-     * @throws Exception if the plugin cannot initialize safely
-     */
-    default void onLoad(final EnginePluginContext context) throws Exception {
-    }
-}
\ No newline at end of file
+    default void onLoad(final EnginePluginContext context) throws Exception {}
+    default void onServerStarted(final EnginePluginContext context) throws Exception {}
+    default void onServerStopping(final EnginePluginContext context) throws Exception {}
+    default void onUnload(final EnginePluginContext context) throws Exception {}
+}
diff --git a/src/main/java/io/violetmc/violetcore/engine/api/EnginePluginContext.java b/src/main/java/io/violetmc/violetcore/engine/api/EnginePluginContext.java
index cdc4873ad90f814246852133371674d50a79f330..dd5d10f42a19c1dc3bf19607c2e5cccfec67f891 100644
--- a/src/main/java/io/violetmc/violetcore/engine/api/EnginePluginContext.java
+++ b/src/main/java/io/violetmc/violetcore/engine/api/EnginePluginContext.java
@@ -1,36 +1,17 @@
 package io.violetmc.violetcore.engine.api;
 
 import java.nio.file.Path;
+import java.util.List;
 import java.util.logging.Logger;
 
-/** Runtime context exposed to Engine Plugins during early bootstrap. */
 public interface EnginePluginContext {
     EnginePluginDescription description();
-
     Logger logger();
-
     Path dataDirectory();
-
     Path enginePluginsDirectory();
-
-    /**
-     * Registers a tick observer. Tick observers are intentionally narrow and
-     * safe: they observe timing and may schedule their own work, but they do not
-     * replace VioletCore internals.
-     */
+    List<String> loadedEnginePlugins();
+    boolean isModificationDeclared(String area);
     void registerTickObserver(TickObserver observer);
-
-    /**
-     * Registers an entity tick controller. This hook can skip normal entity
-     * ticking for selected entities and is intended for performance modules.
-     */
     void registerEntityTickController(EntityTickController controller);
-
-    /**
-     * Allows an Engine Plugin to set a JVM system property before the server
-     * engine finishes booting.
-     */
-    default void setSystemProperty(final String key, final String value) {
-        System.setProperty(key, value);
-    }
-}
\ No newline at end of file
+    default void setSystemProperty(final String key, final String value) { System.setProperty(key, value); }
+}
