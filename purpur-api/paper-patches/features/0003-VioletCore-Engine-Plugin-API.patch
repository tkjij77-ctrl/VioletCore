+++ b/src/main/java/io/violetmc/violetcore/engine/api/TickObserver.java
@@ -0,0 +1,10 @@
+package io.violetmc.violetcore.engine.api;
+
+/** Safe tick hook for Engine Plugins. */
+public interface TickObserver {
+    default void onServerTickStart(final int tick) {
+    }
+
+    default void onServerTickEnd(final int tick, final double tickDurationMillis, final long remainingNanos) {
+    }
+}
