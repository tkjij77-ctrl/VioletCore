index 0000000000000000000000000000000000000000..2cdb1630b7933bad3a052d03be1cffa0dbc7fcac
--- /dev/null
+++ b/src/main/java/io/violetmc/violetcore/engine/EnginePluginManager.java
@@ -0,0 +1,477 @@
+package io.violetmc.violetcore.engine;
+
+import io.violetmc.violetcore.engine.api.EnginePlugin;
+import io.violetmc.violetcore.engine.api.EnginePluginDescription;
+import io.violetmc.violetcore.engine.api.EntityTickController;
+import io.violetmc.violetcore.engine.api.EngineStatsProvider;
+import io.violetmc.violetcore.engine.api.TickObserver;
+import java.io.IOException;
+import java.io.InputStream;
+import java.lang.reflect.Constructor;
+import java.net.URL;
+import java.net.URLClassLoader;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.LongAdder;
+import java.util.jar.JarEntry;
+import java.util.jar.JarFile;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+import java.util.regex.Pattern;
+import net.minecraft.SystemReport;
+
+/** Early bootstrap loader for VioletCore Engine Plugins. */
+public final class EnginePluginManager {
+    public static final String SERVER_NAME = "VioletCore";
+    public static final String TARGET_VERSION = "26.2";
+    public static final String METADATA_FILE = "engine-plugin.yml";
+    public static final String ENTITY_TICKING_AREA = "entity-ticking";
+
+    private static final Pattern SAFE_PLUGIN_NAME = Pattern.compile("[A-Za-z0-9_.-]{1,64}");
+    private static final Logger LOGGER = Logger.getLogger("VioletCore/EnginePlugins");
+    private static final List<EnginePluginInstance> LOADED_PLUGINS = new CopyOnWriteArrayList<>();
+    private static final List<RegisteredTickObserver> TICK_OBSERVERS = new CopyOnWriteArrayList<>();
+    private static final List<RegisteredEntityTickController> ENTITY_TICK_CONTROLLERS = new CopyOnWriteArrayList<>();
+    private static final List<RegisteredStatsProvider> STATS_PROVIDERS = new CopyOnWriteArrayList<>();
+    private static final LongAdder ENTITY_TICK_CONTROLLER_CHECKS = new LongAdder();
+    private static final LongAdder ENTITY_TICK_CONTROLLER_SKIPS = new LongAdder();
+    private static final ConcurrentHashMap<String, LongAdder> ENTITY_TICK_SKIPS_BY_PLUGIN = new ConcurrentHashMap<>();
+    private static final Set<String> CLAIMED_MODIFICATION_AREAS = new HashSet<>();
+    private static volatile boolean bootstrapped;
+    private static volatile boolean disabled;
+    private static volatile boolean serverStarted;
+    private static volatile boolean serverStopping;
+    private static volatile Path enginePluginsDirectory = Path.of("engine-plugins");
+    private static volatile EnginePluginConfig config = EnginePluginConfig.defaults();
+
+    private EnginePluginManager() {
+    }
+
+    public static synchronized void bootstrap(final Path directory, final boolean disableEnginePlugins) {
+        if (bootstrapped) {
+            LOGGER.warning("EnginePluginManager.bootstrap was called more than once; ignoring the second call.");
+            return;
+        }
+
+        bootstrapped = true;
+        disabled = disableEnginePlugins;
+        enginePluginsDirectory = directory == null ? Path.of("engine-plugins") : directory;
+        config = EnginePluginConfig.load(Path.of(EnginePluginConfig.CONFIG_FILE_NAME));
+
+        LOGGER.info("Starting " + SERVER_NAME + " Engine Plugin bootstrap for target version " + TARGET_VERSION + ".");
+        if (config.debugLogging()) {
+            LOGGER.info("Engine config: " + String.join("; ", config.summaryLines()));
+        }
+        if (disabled || !config.engineEnabled()) {
+            disabled = true;
+            LOGGER.warning("Engine Plugins are disabled by command-line flag, system property, or engine-plugins.yml.");
+            return;
+        }
+
+        try {
+            Files.createDirectories(enginePluginsDirectory);
+        } catch (IOException ex) {
+            LOGGER.log(Level.SEVERE, "Could not create engine plugin directory " + enginePluginsDirectory.toAbsolutePath(), ex);
+            return;
+        }
+
+        final List<Path> jars;
+        try (var stream = Files.list(enginePluginsDirectory)) {
+            jars = stream
+                .filter(path -> Files.isRegularFile(path) && path.getFileName().toString().toLowerCase(Locale.ROOT).endsWith(".jar"))
+                .sorted(Comparator.comparing(path -> path.getFileName().toString().toLowerCase(Locale.ROOT)))
+                .toList();
+        } catch (IOException ex) {
+            LOGGER.log(Level.SEVERE, "Could not list engine plugin directory " + enginePluginsDirectory.toAbsolutePath(), ex);
+            return;
+        }
+
+        if (jars.isEmpty()) {
+            LOGGER.info("No Engine Plugins found in " + enginePluginsDirectory.toAbsolutePath() + ".");
+            return;
+        }
+
+        final Map<String, EnginePluginDescription> acceptedDescriptions = new LinkedHashMap<>();
+        final Map<String, Set<String>> claimedAreasByPlugin = new HashMap<>();
+        for (final Path jar : jars) {
+            final EnginePluginDescription description;
+            try {
+                description = readDescription(jar);
+            } catch (Exception ex) {
+                LOGGER.log(Level.SEVERE, "Skipping invalid Engine Plugin jar " + jar.toAbsolutePath(), ex);
+                continue;
+            }
+
+            if (config.isPluginDisabled(description.name())) {
+                LOGGER.warning("Skipping Engine Plugin " + description.displayName() + ": disabled in " + config.path().toAbsolutePath() + ".");
+                continue;
+            }
+            if (!validateDescription(description)) {
+                continue;
+            }
+            if (!validateConflicts(description, acceptedDescriptions, claimedAreasByPlugin)) {
+                continue;
+            }
+
+            acceptedDescriptions.put(description.name(), description);
+            claimedAreasByPlugin.put(description.name(), new HashSet<>(description.modifies()));
+            CLAIMED_MODIFICATION_AREAS.addAll(description.modifies());
+        }
+
+        for (final EnginePluginDescription description : acceptedDescriptions.values()) {
+            load(description);
+        }
+
+        LOGGER.info("Engine Plugin bootstrap complete. Loaded " + LOADED_PLUGINS.size() + " plugin(s): " + describeLoadedPlugins() + ".");
+        if (!TICK_OBSERVERS.isEmpty()) {
+            LOGGER.info("Registered " + TICK_OBSERVERS.size() + " Engine Plugin tick observer(s).");
+        }
+        if (!ENTITY_TICK_CONTROLLERS.isEmpty()) {
+            LOGGER.info("Registered " + ENTITY_TICK_CONTROLLERS.size() + " Engine Plugin entity tick controller(s).");
+        }
+    }
+
+    private static EnginePluginDescription readDescription(final Path jarPath) throws IOException {
+        try (JarFile jar = new JarFile(jarPath.toFile())) {
+            JarEntry entry = jar.getJarEntry(METADATA_FILE);
+            if (entry == null) {
+                entry = jar.getJarEntry("violet-engine-plugin.yml");
+            }
+            if (entry == null) {
+                entry = jar.getJarEntry("META-INF/" + METADATA_FILE);
+            }
+            if (entry == null) {
+                throw new IOException("Missing " + METADATA_FILE + " metadata");
+            }
+            try (InputStream input = jar.getInputStream(entry)) {
+                return EnginePluginDescriptionParser.parse(input, jarPath);
+            }
+        }
+    }
+
+    private static boolean validateDescription(final EnginePluginDescription description) {
+        if (!SAFE_PLUGIN_NAME.matcher(description.name()).matches()) {
+            LOGGER.severe("Skipping Engine Plugin " + description.displayName() + ": name must match " + SAFE_PLUGIN_NAME.pattern() + ".");
+            return false;
+        }
+        if (!"engine-plugin".equalsIgnoreCase(description.type())) {
+            LOGGER.severe("Skipping Engine Plugin " + description.displayName() + ": type must be engine-plugin but was " + description.type() + ".");
+            return false;
+        }
+        if (description.mainClass() == null) {
+            LOGGER.severe("Skipping Engine Plugin " + description.displayName() + ": missing required main class.");
+            return false;
+        }
+        if (!"pre-minecraft".equalsIgnoreCase(description.loadPhase())) {
+            LOGGER.severe("Skipping Engine Plugin " + description.displayName() + ": only load-phase pre-minecraft is supported in this release.");
+            return false;
+        }
+        if (!SERVER_NAME.equalsIgnoreCase(description.targetServer())) {
+            LOGGER.severe("Skipping Engine Plugin " + description.displayName() + ": target-server must be " + SERVER_NAME + " but was " + description.targetServer() + ".");
+            return false;
+        }
+        if (!TARGET_VERSION.equals(description.targetVersion())) {
+            final String message = "Engine Plugin " + description.displayName() + ": target-version should be " + TARGET_VERSION + " but was " + description.targetVersion() + ".";
+            if (config.strictVersionCheck()) {
+                LOGGER.severe("Skipping " + message);
+                return false;
+            }
+            LOGGER.warning(message + " strict-version-check=false, loading anyway.");
+        }
+        if (description.reloadable()) {
+            LOGGER.warning("Engine Plugin " + description.displayName() + " declares reloadable=true; restart-only enforced.");
+        }
+        if (!description.mixinConfigs().isEmpty()) {
+            LOGGER.warning("Engine Plugin " + description.displayName() + " declares mixin configs " + description.mixinConfigs() + ". Mixins are not enabled yet.");
+        }
+        return true;
+    }
+
+    private static boolean validateConflicts(
+        final EnginePluginDescription description,
+        final Map<String, EnginePluginDescription> acceptedDescriptions,
+        final Map<String, Set<String>> claimedAreasByPlugin
+    ) {
+        if (acceptedDescriptions.containsKey(description.name())) {
+            LOGGER.severe("Skipping duplicate Engine Plugin name: " + description.name());
+            return false;
+        }
+        for (final String conflict : description.conflicts()) {
+            if (acceptedDescriptions.containsKey(conflict)) {
+                LOGGER.severe("Skipping Engine Plugin " + description.displayName() + ": conflicts with " + conflict + ".");
+                return false;
+            }
+        }
+        for (final EnginePluginDescription accepted : acceptedDescriptions.values()) {
+            if (accepted.conflicts().contains(description.name())) {
+                LOGGER.severe("Skipping Engine Plugin " + description.displayName() + ": conflict declared by " + accepted.displayName() + ".");
+                return false;
+            }
+        }
+        for (final String area : description.modifies()) {
+            for (final Map.Entry<String, Set<String>> entry : claimedAreasByPlugin.entrySet()) {
+                if (entry.getValue().contains(area)) {
+                    LOGGER.severe("Skipping Engine Plugin " + description.displayName() + ": modification area '" + area + "' is already claimed by " + entry.getKey() + ".");
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    private static void load(final EnginePluginDescription description) {
+        final Path dataDirectory = enginePluginsDirectory.resolve(description.name()).normalize();
+        if (!dataDirectory.startsWith(enginePluginsDirectory.normalize())) {
+            LOGGER.severe("Skipping Engine Plugin " + description.displayName() + ": data directory escapes engine plugin directory.");
+            return;
+        }
+
+        try {
+            Files.createDirectories(dataDirectory);
+        } catch (IOException ex) {
+            LOGGER.log(Level.SEVERE, "Could not create data directory for Engine Plugin " + description.displayName(), ex);
+            return;
+        }
+
+        try {
+            final URLClassLoader classLoader = new URLClassLoader(new URL[] { description.source().toUri().toURL() }, EnginePluginManager.class.getClassLoader());
+            final Class<?> mainClass = Class.forName(description.mainClass(), true, classLoader);
+            final Object instance = instantiate(mainClass);
+            if (!(instance instanceof EnginePlugin plugin)) {
+                classLoader.close();
+                LOGGER.severe("Skipping Engine Plugin " + description.displayName() + ": main class does not implement " + EnginePlugin.class.getName() + ".");
+                return;
+            }
+
+            final SimpleEnginePluginContext context = new SimpleEnginePluginContext(description, dataDirectory, enginePluginsDirectory);
+            plugin.onLoad(context);
+            LOADED_PLUGINS.add(new EnginePluginInstance(description, classLoader, plugin, context));
+            if (plugin instanceof EngineStatsProvider statsProvider) {
+                registerStatsProvider(description, statsProvider);
+            }
+            LOGGER.info("Loaded Engine Plugin " + description.displayName() + " from " + description.source().getFileName() + ".");
+        } catch (Throwable throwable) {
+            LOGGER.log(Level.SEVERE, "Failed to load Engine Plugin " + description.displayName() + ". It will not be enabled.", throwable);
+            if (config.failFastOnPluginError()) {
+                throw new IllegalStateException("Engine Plugin " + description.displayName() + " failed and fail-fast-on-plugin-error=true", throwable);
+            }
+        }
+    }
+
+    private static Object instantiate(final Class<?> mainClass) throws ReflectiveOperationException {
+        final Constructor<?> constructor = mainClass.getDeclaredConstructor();
+        constructor.setAccessible(true);
+        return constructor.newInstance();
+    }
+
+    static void registerTickObserver(final EnginePluginDescription description, final TickObserver observer) {
+        TICK_OBSERVERS.add(new RegisteredTickObserver(description, observer));
+        LOGGER.info("Engine Plugin " + description.displayName() + " registered a tick observer.");
+    }
+
+    static void registerEntityTickController(final EnginePluginDescription description, final EntityTickController controller) {
+        if (config.warnUndeclaredEntityController() && !description.modifies().contains(ENTITY_TICKING_AREA)) {
+            LOGGER.warning("Engine Plugin " + description.displayName() + " registered an entity tick controller without declaring modifies: " + ENTITY_TICKING_AREA + ".");
+        }
+        ENTITY_TICK_CONTROLLERS.add(new RegisteredEntityTickController(description, controller));
+        LOGGER.info("Engine Plugin " + description.displayName() + " registered an entity tick controller.");
+    }
+
+    static void registerStatsProvider(final EnginePluginDescription description, final EngineStatsProvider provider) {
+        STATS_PROVIDERS.add(new RegisteredStatsProvider(description, provider));
+        LOGGER.info("Engine Plugin " + description.displayName() + " registered a stats provider.");
+    }
+
+    public static void fireServerStarted() {
+        if (serverStarted) {
+            return;
+        }
+        serverStarted = true;
+        for (final EnginePluginInstance instance : LOADED_PLUGINS) {
+            try {
+                instance.plugin().onServerStarted(instance.context());
+            } catch (Throwable throwable) {
+                LOGGER.log(Level.SEVERE, "Engine Plugin " + instance.description().displayName() + " failed during onServerStarted.", throwable);
+            }
+        }
+    }
+
+    public static void fireServerStopping() {
+        if (serverStopping) {
+            return;
+        }
+        serverStopping = true;
+        for (final EnginePluginInstance instance : LOADED_PLUGINS) {
+            try {
+                instance.plugin().onServerStopping(instance.context());
+            } catch (Throwable throwable) {
+                LOGGER.log(Level.SEVERE, "Engine Plugin " + instance.description().displayName() + " failed during onServerStopping.", throwable);
+            }
+        }
+    }
+
+    public static void fireServerTickStart(final int tick) {
+        for (final RegisteredTickObserver observer : TICK_OBSERVERS) {
+            try {
+                observer.observer().onServerTickStart(tick);
+            } catch (Throwable throwable) {
+                TICK_OBSERVERS.remove(observer);
+                LOGGER.log(Level.SEVERE, "Disabled tick observer from " + observer.description().displayName() + " after an exception in onServerTickStart.", throwable);
+            }
+        }
+    }
+
+    public static void fireServerTickEnd(final int tick, final double tickDurationMillis, final long remainingNanos) {
+        for (final RegisteredTickObserver observer : TICK_OBSERVERS) {
+            try {
+                observer.observer().onServerTickEnd(tick, tickDurationMillis, remainingNanos);
+            } catch (Throwable throwable) {
+                TICK_OBSERVERS.remove(observer);
+                LOGGER.log(Level.SEVERE, "Disabled tick observer from " + observer.description().displayName() + " after an exception in onServerTickEnd.", throwable);
+            }
+        }
+    }
+
+    public static boolean shouldTickEntity(final org.bukkit.entity.Entity entity, final String worldName, final int tick) {
+        if (ENTITY_TICK_CONTROLLERS.isEmpty()) {
+            return true;
+        }
+        ENTITY_TICK_CONTROLLER_CHECKS.increment();
+        for (final RegisteredEntityTickController controller : ENTITY_TICK_CONTROLLERS) {
+            try {
+                if (!controller.controller().shouldTickEntity(entity, worldName, tick)) {
+                    ENTITY_TICK_CONTROLLER_SKIPS.increment();
+                    ENTITY_TICK_SKIPS_BY_PLUGIN.computeIfAbsent(controller.description().name(), ignored -> new LongAdder()).increment();
+                    return false;
+                }
+            } catch (Throwable throwable) {
+                ENTITY_TICK_CONTROLLERS.remove(controller);
+                LOGGER.log(Level.SEVERE, "Disabled entity tick controller from " + controller.description().displayName() + " after an exception.", throwable);
+            }
+        }
+        return true;
+    }
+
+    public static boolean hasLoadedPlugins() { return !LOADED_PLUGINS.isEmpty(); }
+    public static boolean isBootstrapped() { return bootstrapped; }
+    public static boolean isDisabled() { return disabled; }
+    public static boolean isServerStarted() { return serverStarted; }
+    public static boolean isServerStopping() { return serverStopping; }
+    public static EnginePluginConfig config() { return config; }
+    public static int tickObserverCount() { return TICK_OBSERVERS.size(); }
+    public static int entityTickControllerCount() { return ENTITY_TICK_CONTROLLERS.size(); }
+    public static List<EnginePluginDescription> loadedPluginDescriptions() { return LOADED_PLUGINS.stream().map(EnginePluginInstance::description).toList(); }
+    public static List<String> loadedPluginNames() { return LOADED_PLUGINS.stream().map(instance -> instance.description().displayName()).toList(); }
+    public static String describeLoadedPlugins() { return LOADED_PLUGINS.isEmpty() ? "none" : String.join(", ", loadedPluginNames()); }
+    public static String describeClaimedAreas() { return CLAIMED_MODIFICATION_AREAS.isEmpty() ? "none" : String.join(", ", CLAIMED_MODIFICATION_AREAS); }
+
+    public static String reloadConfig() {
+        final EnginePluginConfig newConfig = EnginePluginConfig.load(config.path());
+        config = newConfig;
+        return String.join("; ", newConfig.summaryLines());
+    }
+
+    public static long entityTickControllerChecks() {
+        return ENTITY_TICK_CONTROLLER_CHECKS.sum();
+    }
+
+    public static long entityTickControllerSkips() {
+        return ENTITY_TICK_CONTROLLER_SKIPS.sum();
+    }
+
+    public static List<String> statsSummaryLines() {
+        final java.util.ArrayList<String> lines = new java.util.ArrayList<>();
+        lines.add("entity-controller-checks=" + entityTickControllerChecks());
+        lines.add("entity-controller-skips=" + entityTickControllerSkips());
+        if (ENTITY_TICK_SKIPS_BY_PLUGIN.isEmpty()) {
+            lines.add("entity-controller-skips-by-plugin=[]");
+        } else {
+            ENTITY_TICK_SKIPS_BY_PLUGIN.entrySet().stream()
+                .sorted(java.util.Map.Entry.comparingByKey())
+                .forEach(entry -> lines.add("entity-controller-skips." + entry.getKey() + "=" + entry.getValue().sum()));
+        }
+        if (STATS_PROVIDERS.isEmpty()) {
+            lines.add("stats-providers=[]");
+        } else {
+            for (final RegisteredStatsProvider provider : STATS_PROVIDERS) {
+                try {
+                    for (final String line : provider.provider().stats()) {
+                        lines.add("provider." + provider.description().name() + "." + line);
+                    }
+                } catch (Throwable throwable) {
+                    lines.add("provider." + provider.description().name() + ".error=" + throwable.getClass().getSimpleName());
+                    LOGGER.log(Level.WARNING, "Engine Plugin " + provider.description().displayName() + " failed while collecting stats.", throwable);
+                }
+            }
+        }
+        return java.util.List.copyOf(lines);
+    }
+
+    public static void resetStats() {
+        ENTITY_TICK_CONTROLLER_CHECKS.reset();
+        ENTITY_TICK_CONTROLLER_SKIPS.reset();
+        ENTITY_TICK_SKIPS_BY_PLUGIN.clear();
+        for (final RegisteredStatsProvider provider : STATS_PROVIDERS) {
+            try {
+                provider.provider().resetStats();
+            } catch (Throwable throwable) {
+                LOGGER.log(Level.WARNING, "Engine Plugin " + provider.description().displayName() + " failed while resetting stats.", throwable);
+            }
+        }
+    }
+
+    public static void addCrashReportDetails(final SystemReport systemReport) {
+        Objects.requireNonNull(systemReport, "systemReport");
+        systemReport.setDetail("VioletCore Engine Plugin Bootstrap", () -> bootstrapped ? (disabled ? "disabled" : "enabled") : "not bootstrapped");
+        systemReport.setDetail("VioletCore Engine Plugin Directory", () -> enginePluginsDirectory.toAbsolutePath().toString());
+        systemReport.setDetail("VioletCore Engine Plugins", EnginePluginManager::describeLoadedPlugins);
+        systemReport.setDetail("VioletCore Engine Claimed Areas", EnginePluginManager::describeClaimedAreas);
+        systemReport.setDetail("VioletCore Engine Config", () -> String.join("; ", config.summaryLines()));
+        systemReport.setDetail("VioletCore Engine Tick Observers", () -> String.valueOf(tickObserverCount()));
+        systemReport.setDetail("VioletCore Engine Entity Tick Controllers", () -> String.valueOf(entityTickControllerCount()));
+        systemReport.setDetail("VioletCore Engine Entity Tick Checks", () -> String.valueOf(entityTickControllerChecks()));
+        systemReport.setDetail("VioletCore Engine Entity Tick Skips", () -> String.valueOf(entityTickControllerSkips()));
+    }
+
+    public static synchronized void shutdown() {
+        fireServerStopping();
+        for (final EnginePluginInstance instance : LOADED_PLUGINS) {
+            try {
+                instance.plugin().onUnload(instance.context());
+            } catch (Throwable throwable) {
+                LOGGER.log(Level.WARNING, "Engine Plugin " + instance.description().displayName() + " failed during onUnload.", throwable);
+            }
+            try {
+                instance.close();
+            } catch (IOException ex) {
+                LOGGER.log(Level.WARNING, "Failed to close classloader for Engine Plugin " + instance.description().displayName(), ex);
+            }
+        }
+        LOADED_PLUGINS.clear();
+        TICK_OBSERVERS.clear();
+        ENTITY_TICK_CONTROLLERS.clear();
+        resetStats();
+        STATS_PROVIDERS.clear();
+        CLAIMED_MODIFICATION_AREAS.clear();
+    }
+
+    private record RegisteredTickObserver(EnginePluginDescription description, TickObserver observer) {
+    }
+
+    private record RegisteredEntityTickController(EnginePluginDescription description, EntityTickController controller) {
+    }
+
+    private record RegisteredStatsProvider(EnginePluginDescription description, EngineStatsProvider provider) {
+    }
+}
