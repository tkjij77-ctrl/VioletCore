@@ -0,0 +1,33 @@
+package io.violetmc.violetcore.engine;
+
+import io.violetmc.violetcore.engine.api.EnginePluginContext;
+import io.violetmc.violetcore.engine.api.EnginePluginDescription;
+import io.violetmc.violetcore.engine.api.EntityTickController;
+import io.violetmc.violetcore.engine.api.TickObserver;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Objects;
+import java.util.logging.Logger;
+
+final class SimpleEnginePluginContext implements EnginePluginContext {
+    private final EnginePluginDescription description;
+    private final Path dataDirectory;
+    private final Path enginePluginsDirectory;
+    private final Logger logger;
+
+    SimpleEnginePluginContext(final EnginePluginDescription description, final Path dataDirectory, final Path enginePluginsDirectory) {
+        this.description = description;
+        this.dataDirectory = dataDirectory;
+        this.enginePluginsDirectory = enginePluginsDirectory;
+        this.logger = Logger.getLogger("VioletCore/EnginePlugin/" + description.name());
+    }
+
+    @Override public EnginePluginDescription description() { return this.description; }
+    @Override public Logger logger() { return this.logger; }
+    @Override public Path dataDirectory() { return this.dataDirectory; }
+    @Override public Path enginePluginsDirectory() { return this.enginePluginsDirectory; }
+    @Override public List<String> loadedEnginePlugins() { return EnginePluginManager.loadedPluginNames(); }
+    @Override public boolean isModificationDeclared(final String area) { return this.description.modifies().contains(area); }
+    @Override public void registerTickObserver(final TickObserver observer) { EnginePluginManager.registerTickObserver(this.description, Objects.requireNonNull(observer, "observer")); }
+    @Override public void registerEntityTickController(final EntityTickController controller) { EnginePluginManager.registerEntityTickController(this.description, Objects.requireNonNull(controller, "controller")); }
+}
