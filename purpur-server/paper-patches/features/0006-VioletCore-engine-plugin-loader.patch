@@ -0,0 +1,31 @@
+package io.violetmc.violetcore.engine;
+
+import io.violetmc.violetcore.engine.api.EnginePlugin;
+import io.violetmc.violetcore.engine.api.EnginePluginContext;
+import io.violetmc.violetcore.engine.api.EnginePluginDescription;
+import java.io.Closeable;
+import java.io.IOException;
+import java.net.URLClassLoader;
+
+final class EnginePluginInstance implements Closeable {
+    private final EnginePluginDescription description;
+    private final URLClassLoader classLoader;
+    private final EnginePlugin plugin;
+    private final EnginePluginContext context;
+
+    EnginePluginInstance(final EnginePluginDescription description, final URLClassLoader classLoader, final EnginePlugin plugin, final EnginePluginContext context) {
+        this.description = description;
+        this.classLoader = classLoader;
+        this.plugin = plugin;
+        this.context = context;
+    }
+
+    EnginePluginDescription description() { return this.description; }
+    EnginePlugin plugin() { return this.plugin; }
+    EnginePluginContext context() { return this.context; }
+
+    @Override
+    public void close() throws IOException {
+        this.classLoader.close();
+    }
+}
