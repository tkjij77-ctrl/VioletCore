+++ b/src/main/java/io/violetmc/violetcore/engine/VioletCoreCommand.java
@@ -0,0 +1,118 @@
+package io.violetmc.violetcore.engine;
+
+import io.violetmc.violetcore.engine.api.EnginePluginDescription;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import org.bukkit.Bukkit;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.permissions.Permission;
+import org.bukkit.permissions.PermissionDefault;
+
+public final class VioletCoreCommand extends Command {
+    private static final String PERMISSION = "bukkit.command.violetcore";
+
+    public VioletCoreCommand(final String name) {
+        super(name);
+        this.description = "VioletCore status and Engine Plugin information";
+        this.usageMessage = "/violetcore [status|engineplugins|hooks|config|reloadconfig|stats|resetstats|version]";
+        this.setAliases(List.of("vc", "vcore"));
+        this.setPermission(PERMISSION);
+        try {
+            Bukkit.getServer().getPluginManager().addPermission(new Permission(PERMISSION, PermissionDefault.OP));
+        } catch (IllegalArgumentException ignored) {
+        }
+    }
+
+    @Override
+    public boolean execute(final CommandSender sender, final String commandLabel, final String[] args) {
+        if (!this.testPermission(sender)) {
+            return true;
+        }
+
+        final String sub = args.length == 0 ? "status" : args[0].toLowerCase(Locale.ROOT);
+        switch (sub) {
+            case "status" -> sendStatus(sender);
+            case "engineplugins", "plugins" -> sendEnginePlugins(sender);
+            case "hooks" -> sendHooks(sender);
+            case "config" -> sendConfig(sender);
+            case "reloadconfig" -> reloadConfig(sender);
+            case "stats" -> sendStats(sender);
+            case "resetstats" -> resetStats(sender);
+            case "version" -> sendVersion(sender);
+            default -> sender.sendMessage(Component.text("Usage: " + this.usageMessage, NamedTextColor.RED));
+        }
+        return true;
+    }
+
+    @Override
+    public List<String> tabComplete(final CommandSender sender, final String alias, final String[] args, final org.bukkit.Location location) throws IllegalArgumentException {
+        if (args.length == 1) {
+            final String prefix = args[0].toLowerCase(Locale.ROOT);
+            return List.of("status", "engineplugins", "hooks", "config", "reloadconfig", "stats", "resetstats", "version").stream().filter(s -> s.startsWith(prefix)).toList();
+        }
+        return Collections.emptyList();
+    }
+
+    private static void sendStatus(final CommandSender sender) {
+        sender.sendMessage(Component.text("VioletCore Engine Status", NamedTextColor.LIGHT_PURPLE));
+        sender.sendMessage(Component.text(" - Target: " + EnginePluginManager.TARGET_VERSION, NamedTextColor.GRAY));
+        sender.sendMessage(Component.text(" - Bootstrap: " + (EnginePluginManager.isBootstrapped() ? (EnginePluginManager.isDisabled() ? "disabled" : "enabled") : "not bootstrapped"), NamedTextColor.GRAY));
+        sender.sendMessage(Component.text(" - Server started: " + EnginePluginManager.isServerStarted(), NamedTextColor.GRAY));
+        sender.sendMessage(Component.text(" - Loaded Engine Plugins: " + EnginePluginManager.loadedPluginNames().size(), NamedTextColor.GRAY));
+        sender.sendMessage(Component.text(" - Claimed areas: " + EnginePluginManager.describeClaimedAreas(), NamedTextColor.GRAY));
+        sender.sendMessage(Component.text(" - Config: " + EnginePluginManager.config().path().toAbsolutePath(), NamedTextColor.GRAY));
+    }
+
+    private static void sendEnginePlugins(final CommandSender sender) {
+        final List<EnginePluginDescription> descriptions = new ArrayList<>(EnginePluginManager.loadedPluginDescriptions());
+        if (descriptions.isEmpty()) {
+            sender.sendMessage(Component.text("No Engine Plugins loaded.", NamedTextColor.YELLOW));
+            return;
+        }
+        sender.sendMessage(Component.text("Loaded Engine Plugins:", NamedTextColor.LIGHT_PURPLE));
+        for (final EnginePluginDescription description : descriptions) {
+            sender.sendMessage(Component.text(" - " + description.displayName() + " [" + String.join(", ", description.modifies()) + "]", NamedTextColor.GRAY));
+        }
+    }
+
+    private static void sendHooks(final CommandSender sender) {
+        sender.sendMessage(Component.text("VioletCore Engine Hooks", NamedTextColor.LIGHT_PURPLE));
+        sender.sendMessage(Component.text(" - Tick observers: " + EnginePluginManager.tickObserverCount(), NamedTextColor.GRAY));
+        sender.sendMessage(Component.text(" - Entity tick controllers: " + EnginePluginManager.entityTickControllerCount(), NamedTextColor.GRAY));
+    }
+
+    private static void sendConfig(final CommandSender sender) {
+        sender.sendMessage(Component.text("VioletCore Engine Config", NamedTextColor.LIGHT_PURPLE));
+        for (final String line : EnginePluginManager.config().summaryLines()) {
+            sender.sendMessage(Component.text(" - " + line, NamedTextColor.GRAY));
+        }
+    }
+
+    private static void reloadConfig(final CommandSender sender) {
+        final String summary = EnginePluginManager.reloadConfig();
+        sender.sendMessage(Component.text("VioletCore engine-plugins.yml reloaded.", NamedTextColor.GREEN));
+        sender.sendMessage(Component.text(summary, NamedTextColor.GRAY));
+        sender.sendMessage(Component.text("Note: loading/unloading Engine Plugin jars still requires a full restart.", NamedTextColor.YELLOW));
+    }
+
+    private static void sendStats(final CommandSender sender) {
+        sender.sendMessage(Component.text("VioletCore Engine Stats", NamedTextColor.LIGHT_PURPLE));
+        for (final String line : EnginePluginManager.statsSummaryLines()) {
+            sender.sendMessage(Component.text(" - " + line, NamedTextColor.GRAY));
+        }
+    }
+
+    private static void resetStats(final CommandSender sender) {
+        EnginePluginManager.resetStats();
+        sender.sendMessage(Component.text("VioletCore Engine stats reset.", NamedTextColor.GREEN));
+    }
+
+    private static void sendVersion(final CommandSender sender) {
+        sender.sendMessage(Component.text("VioletCore " + EnginePluginManager.TARGET_VERSION + " (Engine Plugins MVP)", NamedTextColor.LIGHT_PURPLE));
+    }
+}
